# Copy to .env.local for local dev. Add the same values in
# Vercel -> Project -> Settings -> Environment Variables.

# MongoDB Atlas -> Connect -> Drivers -> copy the connection string
# and replace <db_password> with your database user's password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional. If both are set they override any credentials in MONGODB_URI
# (matches the atlas-credentials.env file Atlas generates; no URL-encoding needed).
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Optional. Database name; defaults to python_fastapi_tracker.
MONGODB_DB=python_fastapi_tracker

# Signs login cookies. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string
